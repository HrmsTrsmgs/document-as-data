<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Marimo.DocumentAsData.CodeGeneration.Test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocumentAsData\DocumentAsData.csproj" />
    <ProjectReference Include="..\..\src\DocumentAsData.Build\DocumentAsData.Build.csproj" />
    <ProjectReference Include="..\..\src\DocumentAsData.CodeGeneration\DocumentAsData.CodeGeneration.csproj" />
    <!-- 統合パッケージの梱包テスト用にビルドします。テストの参照DLLには追加しません。 -->
    <ProjectReference Include="..\..\src\DocumentAsData.Package\DocumentAsData.Package.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(MSBuildToolsPath)\Microsoft.Build.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.Core">
      <HintPath>$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 繰り返しセクションの固定データはCoreのテストと共有します。 -->
    <None Include="..\DocumentAsData.Tests\TestData\繰り返しセクションのContent Control.docx" Link="TestData\コード生成\repeatingTemplate.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\繰り返しセクションに2件の明細.docx" Link="TestData\コード生成\repeatingItems.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\異なるTagの繰り返しセクション.docx" Link="TestData\コード生成\repeatingSections.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\明細の内外に同じTag.docx" Link="TestData\コード生成\repeatingOutside.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\明細の内外に同名のMERGEFIELD.docx" Link="TestData\コード生成\repeatingOutsideMergeField.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\明細の内外に同名のCheckBox.docx" Link="TestData\コード生成\repeatingOutsideCheckBox.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\明細の内外に同名のDatePicker.docx" Link="TestData\コード生成\repeatingOutsideDatePicker.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\通常は文字列Content Control 明細は同名の2種類.docx" Link="TestData\コード生成\repeatingFallbackContentControl.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\通常はMERGEFIELD 明細は同名の2種類.docx" Link="TestData\コード生成\repeatingFallbackMergeField.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\明細に4種類の項目.docx" Link="TestData\コード生成\repeatingKinds.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\繰り返しセクションの明細に項目が不足.docx" Link="TestData\コード生成\repeatingMissingItem.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\1件の明細内に同じTag.docx" Link="TestData\コード生成\repeatingDuplicateItem.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DocumentAsData.Tests\TestData\複合形式のMERGEFIELD.docx"
          Link="TestData\コード生成\単一項目.docx"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DocumentAsData.Tests\TestData\同名のMERGEFIELDとContent Control.docx"
          Link="TestData\コード生成\同名のMERGEFIELDとContent Control.docx"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\DocumentAsData.Tests\TestData\名前に改行を含むMERGEFIELD.docx"
          Link="TestData\コード生成\名前に改行を含むMERGEFIELD.docx"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
