<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Marimo.DocumentAsData</RootNamespace>
    <PackageId>Marimo.DocumentAsData.Core</PackageId>
    <Description>DOCXの名前付き項目を構造化データとして読み書きします。</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.Interactive" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocumentAsData.CodeGeneration" />
    <InternalsVisibleTo Include="DocumentAsData.CodeGeneration.Tests" />
    <Compile Include="..\DocumentAsData.CodeGeneration\CSharpIdentifier.cs" Link="CSharpIdentifier.cs" />
  </ItemGroup>

</Project>
