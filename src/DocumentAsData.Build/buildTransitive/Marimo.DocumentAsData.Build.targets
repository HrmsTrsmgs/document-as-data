<Project>
  <!-- 明示指定がない場合は、パッケージ内のタスクDLLを参照します。 -->
  <PropertyGroup>
    <DocumentAsDataTaskAssembly Condition="'$(DocumentAsDataTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\DocumentAsData.Build.dll</DocumentAsDataTaskAssembly>
  </PropertyGroup>
  <UsingTask
    TaskName="Marimo.DocumentAsData.Build.GenerateDocumentAsData"
    AssemblyFile="$(DocumentAsDataTaskAssembly)" />

  <!-- 通常評価とデザイン時の両方で、文書の隣の生成済みソースをコンパイル対象として参照します。 -->
  <ItemGroup>
    <!-- 元文書と生成ソースの対応を保持し、同じ評価内の項目登録・除外で共有します。 -->
    <DocumentAsData Update="@(DocumentAsData)">
      <DocumentAsDataDependentUpon>%(Filename)%(Extension)</DocumentAsDataDependentUpon>
      <LastGenOutput>%(Filename).DocumentAsData.g.cs</LastGenOutput>
      <DocumentAsDataGeneratedFilePath>%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs</DocumentAsDataGeneratedFilePath>
    </DocumentAsData>
    <!-- SDKの既定Compile項目に含まれる場合も、対象の生成ファイルを一度だけ登録します。 -->
    <Compile Remove="@(DocumentAsData->'%(DocumentAsDataGeneratedFilePath)')" />
    <None Remove="@(DocumentAsData->'%(DocumentAsDataGeneratedFilePath)')" />
    <Content Remove="@(DocumentAsData->'%(DocumentAsDataGeneratedFilePath)')" />
    <Compile
      Include="@(DocumentAsData->'%(DocumentAsDataGeneratedFilePath)')"
      DependentUpon="%(DocumentAsDataDependentUpon)" />
  </ItemGroup>

  <!-- 明示実行に加え、通常のコンパイル前にも生成します。デザイン時は生成済みソースを参照するだけです。 -->
  <Target
    Name="GenerateDocumentAsDataSources"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true' and '@(DocumentAsData)' != ''">
    <Marimo.DocumentAsData.Build.GenerateDocumentAsData
      DocumentFiles="@(DocumentAsData)"
      RootNamespace="$(RootNamespace)"
      ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- 標準Cleanはbin/obj外を削除しないため、現在の対象文書に対応する生成ソースだけを削除します。 -->
  <Target Name="CleanDocumentAsDataSources" AfterTargets="CoreClean">
    <!-- 評価後に追加・変更された項目も反映するため、実行時の対象文書から生成先を計算します。 -->
    <Delete Files="@(DocumentAsData->'%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs')" />
  </Target>
</Project>
