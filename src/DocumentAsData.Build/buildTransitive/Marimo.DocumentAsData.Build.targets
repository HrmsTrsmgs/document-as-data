<Project>
  <!-- 呼び出し側でDocumentAsDataTaskAssemblyにビルド済みタスクDLLのパスを指定します。 -->
  <UsingTask
    TaskName="Marimo.DocumentAsData.Build.GenerateDocumentAsData"
    AssemblyFile="$(DocumentAsDataTaskAssembly)" />

  <!-- 通常評価とデザイン時の両方で、文書の隣の生成済みソースをコンパイル対象として参照します。 -->
  <ItemGroup>
    <!-- 生成ソースへのパス変換前に、親となる元文書のファイル名を保持します。 -->
    <DocumentAsData Update="@(DocumentAsData)">
      <DocumentAsDataDependentUpon>%(Filename)%(Extension)</DocumentAsDataDependentUpon>
      <LastGenOutput>%(Filename).DocumentAsData.g.cs</LastGenOutput>
    </DocumentAsData>
    <!-- SDKの既定Compile項目に含まれる場合も、対象の生成ファイルを一度だけ登録します。 -->
    <Compile Remove="@(DocumentAsData->'%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs')" />
    <None Remove="@(DocumentAsData->'%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs')" />
    <Content Remove="@(DocumentAsData->'%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs')" />
    <Compile
      Include="@(DocumentAsData->'%(RootDir)%(Directory)%(Filename).DocumentAsData.g.cs')"
      DependentUpon="%(DocumentAsDataDependentUpon)" />
  </ItemGroup>

  <!-- 明示実行に加え、通常のコンパイル前にも生成します。デザイン時は生成済みソースを参照するだけです。 -->
  <Target
    Name="GenerateDocumentAsDataSources"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Marimo.DocumentAsData.Build.GenerateDocumentAsData
      DocumentFiles="@(DocumentAsData)"
      RootNamespace="$(RootNamespace)"
      ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
