<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="buildTransitive\Marimo.DocumentAsData.Build.Naming.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Marimo.DocumentAsData.Build</RootNamespace>
    <PackageId>Marimo.DocumentAsData.Build</PackageId>
    <Description>MSBuildによるDocumentAsDataのコード自動生成を提供します。</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddDocumentAsDataBuildToolsToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- 生成器はtools内でのみ使い、利用アプリへはCoreだけを依存パッケージとして渡します。 -->
    <ProjectReference Include="..\DocumentAsData.CodeGeneration\DocumentAsData.CodeGeneration.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\DocumentAsData\DocumentAsData.csproj" />
  </ItemGroup>

  <!-- 利用側で読み込むMSBuild連携設定をパッケージへ含めます。 -->
  <ItemGroup>
    <None Update="buildTransitive\Marimo.DocumentAsData.Build.props" Pack="true" PackagePath="buildTransitive\Marimo.DocumentAsData.Build.props" />
    <None Update="buildTransitive\Marimo.DocumentAsData.Build.targets" Pack="true" PackagePath="buildTransitive\Marimo.DocumentAsData.Build.targets" />
    <None Update="buildTransitive\Marimo.DocumentAsData.Build.Naming.props" Pack="true" PackagePath="buildTransitive\Marimo.DocumentAsData.Build.Naming.props" />
    <!-- .NET 11向けですが、利用アプリへ追加する参照DLLはないことをNuGetへ示します。 -->
    <None Update="PackagePlaceholder\_._" Pack="true" PackagePath="lib\net11.0\_._" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(MSBuildToolsPath)\Microsoft.Build.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.Core">
      <HintPath>$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- タスク単体でも、利用側のMSBuild設定と同じ接尾辞を使います。 -->
  <Target Name="GenerateDocumentAsDataFileSuffix" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_GeneratedFileSuffixSource>$(IntermediateOutputPath)DocumentAsDataFileSuffix.g.cs</_GeneratedFileSuffixSource>
      <_GeneratedFileSuffixSourceText>// &lt;auto-generated /&gt;
namespace Marimo.DocumentAsData.Build%3B

partial class GenerateDocumentAsData
{
    const string GeneratedFileSuffix = "$(_DocumentAsDataGeneratedFileSuffix)"%3B
}</_GeneratedFileSuffixSourceText>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_GeneratedFileSuffixSource)"
      Lines="$(_GeneratedFileSuffixSourceText)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GeneratedFileSuffixSource)" />
      <FileWrites Include="$(_GeneratedFileSuffixSource)" />
    </ItemGroup>
  </Target>

  <!-- MSBuildがタスクの依存DLLを同じディレクトリから解決できるように配置します。 -->
  <Target Name="AddDocumentAsDataBuildToolsToPackage" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)*.dll">
        <PackagePath>tools\net11.0\%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
